{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ginput-usage-stats",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  // 只用 jetpiggy.com 的子網域；不開 workers.dev 和預覽網址。
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ginput-stats.jetpiggy.com", "custom_domain": true }],
  // 不記錄請求日誌（ADR 0001）。
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ginput-usage-stats",
      "database_id": "e4d1bb91-003f-4dfa-8909-2123b43213d2",
      "migrations_dir": "migrations"
    }
  ]
}
