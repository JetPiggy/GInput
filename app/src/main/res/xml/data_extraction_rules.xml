<?xml version="1.0" encoding="utf-8"?>
<!-- 只備份設定（settings）和常用短語（phrases），兩者都在 SharedPreferences（ADR 0001）；其餘資料放在 noBackupFilesDir。
     逐個檔案列出，因為手寫用的 ML Kit 也把識別碼和模型紀錄放在 SharedPreferences，這些不備份（ADR 0015）。Android 12 或以上用這個檔案。 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="settings.xml" />
        <include domain="sharedpref" path="phrases.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="settings.xml" />
        <include domain="sharedpref" path="phrases.xml" />
    </device-transfer>
</data-extraction-rules>
