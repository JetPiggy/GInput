    <string name="remember_candidates">Remember picks</string>
    <string name="remember_candidates_summary">Characters you pick twice move to the front, highlighted in green (most-common-first order only). With continuous typing on, it also remembers which characters go together, for better sentences</string>
    <string name="continuous_typing">Continuous typing</string>
    <string name="continuous_typing_summary">Type the codes of several characters in a row in Quick or Cangjie and pick the whole sentence. Quick can guess wrong, so check before you pick. Long-press the sentence to fix a character</string>
    <string name="clear_memory">Clear remembered characters</string>
    <string name="clear_memory_summary">Puts every remembered character back in its usual place and forgets the characters continuous typing remembered together</string>
    <string name="clear_memory_confirm_title">Clear all remembered characters?</string>
    <string name="clear_memory_confirm">Clear</string>
    <string name="clear_memory_done">Remembered characters cleared</string>

    <string name="section_typing">Typing</string>
    <string name="colloquial_priority">Colloquial Cantonese first</string>
    <string name="colloquial_priority_summary">Puts characters such as 嘅 and 咗 first and suggests colloquial words</string>
    <string name="space_mode">Space bar</string>
    <string name="space_english">Writes the letters as English</string>
    <string name="space_chinese">Picks the first Chinese candidate</string>
    <string name="smart_space_removal">Smart space removal</string>
    <string name="smart_space_removal_summary">Removes the space after an English word when Chinese or punctuation follows</string>
    <string name="auto_capitalize">Auto-capitalisation</string>
    <string name="auto_capitalize_summary">Capitalises the first English letter of each sentence</string>
    <string name="emoji_keywords">Emoji keywords</string>
    <string name="emoji_keywords_summary">Suggests related emoji at the right of the candidate bar after Chinese words, e.g. 😊 after 開心</string>
    <string name="english_chinese">English-Chinese dictionary</string>
    <string name="english_chinese_summary">Also lists the Chinese for a whole English word in the candidate bar, e.g. 鴨 for duck</string>

