    <string name="section_schemes">Chinese input</string>
    <string name="scheme_quick">Quick</string>
    <string name="scheme_quick_summary">First and last Cangjie codes, e.g. HI for 我</string>
    <string name="scheme_cangjie">Cangjie</string>
    <string name="scheme_cangjie_summary">Full Cangjie codes, e.g. HQI for 我</string>
    <string name="scheme_jyutping">Jyutping</string>
    <string name="scheme_jyutping_summary">Cantonese romanisation without tones, e.g. NGO for 我</string>
    <string name="scheme_order_hint">When more than one is on, candidates from the first one come first. At least one must be on.</string>
    <string name="scheme_move_up">Move %1$s up</string>
    <string name="scheme_move_down">Move %1$s down</string>
    <string name="cangjie_generation">Cangjie version</string>
    <string name="loose_spelling">Loose Jyutping spelling</string>
    <string name="loose_spelling_summary">Also accept lazy and Hong Kong spellings, e.g. lei for 你, o for 我, yau for 有, cheung for 張</string>
    <string name="generation_both">3rd and 5th generation</string>
    <string name="generation_third">3rd generation only</string>
